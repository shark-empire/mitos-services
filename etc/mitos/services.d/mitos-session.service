[Unit]
Description=MITOS Session Manager (Seat, Lock, Idle, Power)
Documentation=https://github.com/shark-empire/mitos-session

[Service]
ExecStart=/usr/lib/mitos/mitos-session

# Restart automatically if the daemon panics or crashes
Restart=on-failure
RestartSec=5s

# Optional: If your calloop event loop hangs for 15 seconds without 
# sending a WATCHDOG=1 heartbeat, kill and restart it.
# WatchdogSec=15

# Optional: If you need to ensure this starts strictly AFTER another 
# mitos-services managed daemon (e.g., the network manager), use X-AfterReady:
# X-AfterReady=mitos-network

[Install]
WantedBy=multi-user.target
